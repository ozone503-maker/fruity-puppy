{
  "framework": "nextjs",
  "buildCommand": "next build",
  "rewrites": [
    {
      "source": "/store",
      "destination": "https://fruity-puppy-store.vercel.app/"
    },
    {
      "source": "/store/:path*",
      "destination": "https://fruity-puppy-store.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.fruitypuppy.com"
        }
      ]
    }
  ]
}
